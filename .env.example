# Copie para .env e ajuste os valores. O arquivo .env NUNCA deve ser commitado.
PORT=3000

# Banco (docker compose)
POSTGRES_DB=oficina
POSTGRES_USER=oficina
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# Usado ao rodar a API fora do Docker (npm run start:dev)
DATABASE_URL=postgresql://oficina:troque-esta-senha@localhost:5432/oficina?schema=public

# Gere um segredo forte, ex.: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-com-32+-caracteres
JWT_EXPIRES_IN=1h

# Rate limit das rotas públicas e de login (janela em ms / requisições por janela)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20

# Usuário administrador criado pelo seed (somente ambiente de demonstração)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@oficina.com
ADMIN_SENHA=Admin@123
SEED_ON_START=true
